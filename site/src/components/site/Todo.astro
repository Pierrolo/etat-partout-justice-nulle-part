---
/**
 * Visible placeholder for unfinished sections. Search the repo for `TODO(builder)` to find them all.
 * Delete the component (not just its text) when the real content lands.
 */
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<div class="todo" data-todo>
  <p class="font-semibold text-ink">
    <span class="font-mono text-xs">TODO(builder)</span>
    {title && <span> · {title}</span>}
  </p>
  <div class="mt-1">
    <slot />
  </div>
</div>
