---
import { NAV, SITE, isCurrent, withBase } from '@/lib/site';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
---

<header class="brand-header border-b border-rule bg-paper">
  <!-- Independence strip: inside the banner landmark so that no content sits outside a region. -->
  <div class="brand-strip border-b border-rule bg-sunken text-ink-2" data-testid="independence-strip">
    <p class="wrap py-2 text-xs leading-snug">
      {SITE.independence}
      <a href={withBase('/a-propos/')} class="whitespace-nowrap font-medium">
        En savoir plus
      </a>
    </p>
  </div>
  <div class="wrap grid grid-cols-[1fr_auto] items-center gap-x-3 gap-y-1 py-2 sm:flex sm:py-3">
    <a
      href={withBase('/')}
      class="flex min-h-11 items-center gap-2.5 text-ink no-underline hover:text-ink hover:no-underline sm:me-auto"
    >
      <Logo />
      <span class="font-serif text-lg font-medium tracking-tight sm:text-xl">{SITE.name}</span>
    </a>
    <div class="sm:order-3">
      <ThemeToggle />
    </div>
    <nav aria-label="Navigation principale" class="col-span-2 -mx-2 sm:order-2 sm:col-auto sm:mx-0">
      <ul class="flex flex-wrap items-center justify-between sm:justify-start">
        {NAV.map((item) => {
          const current = isCurrent(path, item.href);
          return (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={current ? 'page' : undefined}
                class:list={[
                  'relative flex min-h-11 items-center px-2 text-sm font-medium no-underline hover:text-ink hover:no-underline sm:px-3 sm:text-[0.9375rem]',
                  current
                    ? 'text-ink after:absolute after:inset-x-2 after:bottom-1.5 after:h-0.5 after:rounded-full after:bg-[var(--nav-mark)] sm:after:inset-x-3'
                    : 'text-ink-2',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
