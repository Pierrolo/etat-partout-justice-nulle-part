---
import { Questionnaire } from '@/components/questionnaire/Questionnaire';
import PageHeader from '@/components/site/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { questionnaire } from '@/lib/questionnaire';

const questions = questionnaire();
---

<BaseLayout
  title="Questionnaire"
  description="Parts du budget, intérêts de la dette, niches, formulaires, organismes."
>
  <PageHeader
    eyebrow="Questionnaire"
    title="À votre avis, où va l’argent public ?"
    lede="Vous répondez, le chiffre s’affiche avec sa source. Mesure, amendement ou annonce du plan : la différence est dite. Rien n’est enregistré."
  />
  <section class="wrap pb-4" aria-labelledby="questionnaire-titre">
    <h2 id="questionnaire-titre" class="sr-only">
      Les questions
    </h2>
    <Questionnaire client:load questions={questions} />
  </section>
</BaseLayout>
