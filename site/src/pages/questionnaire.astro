---
import { Questionnaire } from '@/components/questionnaire/Questionnaire';
import PageHeader from '@/components/site/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { questionnaire } from '@/lib/questionnaire';

const questions = questionnaire();
---

<BaseLayout
  title="Questionnaire"
  description="Des chiffres que l’on ne connaît pas : parts du budget, intérêts de la dette, niches, mots du droit, organismes. Vous répondez, la source s’affiche. Rien n’est enregistré."
>
  <PageHeader
    eyebrow="Questionnaire"
    title="À votre avis, où va l’argent public ?"
    lede="Pas un sondage sur le budget en général. Des comparaisons et des décomptes que presque personne n’a en tête. Vous répondez, le chiffre s’affiche avec sa source. Mesure, amendement ou annonce des auteurs : la différence est dite. Rien n’est enregistré."
  />
  <section class="wrap pb-4" aria-labelledby="questionnaire-titre">
    <h2 id="questionnaire-titre" class="sr-only">
      Les questions
    </h2>
    <Questionnaire client:load questions={questions} />
  </section>
</BaseLayout>
