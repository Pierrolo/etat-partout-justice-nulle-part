---
import PageHeader from '@/components/site/PageHeader.astro';
import Simulator from '@/components/simulator/Simulator';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/site';
---

<BaseLayout
  title="Simulateur"
  description="Calculez ce que le plan changerait pour votre foyer, en euros par mois, avec chaque chiffre relié à sa source."
>
  <PageHeader
    compact
    eyebrow="Simulateur"
    title="Et moi, dans tout ça ?"
    lede="Quelques questions sur votre foyer, et vous voyez l’effet du plan en euros par mois — avec le détail de chaque ligne."
  />
  <Simulator client:load />
  <div class="wrap mt-12">
    <p class="text-sm">
      <a href={withBase('/simulateur/cas-types/')}>Qui gagne, qui perd ? Voir des foyers types →</a>
    </p>
  </div>
</BaseLayout>
