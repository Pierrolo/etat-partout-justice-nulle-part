---
import PageHeader from '@/components/site/PageHeader.astro';
import Simulator from '@/components/simulator/Simulator';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/site';
---

<BaseLayout
  title="Simulateur"
  description="Calculez ce que le plan changerait pour votre foyer, en euros par mois, avec chaque chiffre relié à sa source. Aucun résultat n’est affiché avant que vous ayez répondu."
>
  <div class="sim-page-header">
    <PageHeader
      compact
      eyebrow="Simulateur"
      title="Ce que le plan changerait pour votre foyer"
      lede="Quelques questions sur votre foyer, puis l’effet du plan en euros par mois, avec le détail de chaque ligne. Rien n’est calculé avant que vous ayez répondu."
    />
  </div>

  <!--
    A link that carries a shared situation (#v1.…) must never show the empty default page, even for a
    moment: this inline script runs before the island and hides the pre-rendered form behind a notice;
    the island clears the flag once the situation is restored (or, failing that, after ten seconds).
  -->
  <script is:inline>
    (function () {
      try {
        if (!/^#v\d+\./.test(location.hash)) return;
        var d = document.documentElement;
        d.setAttribute('data-sim-hash', '1');
        setTimeout(function () {
          if (d.getAttribute('data-sim-hash') === '1') d.setAttribute('data-sim-hash', 'timeout');
        }, 10000);
      } catch (e) {}
    })();
  </script>
  <div class="wrap sim-loading" data-testid="sim-loading">
    <p role="status" class="card text-[0.9375rem] text-ink-2">
      Chargement de la simulation partagée…
    </p>
  </div>
  <div class="wrap sim-timeout" data-testid="sim-timeout">
    <p role="alert" class="card text-[0.9375rem] text-ink">
      La simulation partagée n’a pas pu se charger. Rechargez la page ; si le problème continue,
      refaites la simulation depuis le début.
    </p>
  </div>
  <noscript>
    <div class="wrap">
      <p class="card text-[0.9375rem] text-ink" data-testid="sim-noscript">
        <strong>Le simulateur a besoin de JavaScript.</strong> Le calcul se fait dans votre
        navigateur : rien n’est envoyé à un serveur, et sans JavaScript il ne peut pas s’exécuter.
        Activez JavaScript pour répondre aux questions. En attendant, les
        <a href={withBase('/simulateur/cas-types/')}>foyers types</a> montrent l’effet du plan sur
        d’autres situations.
      </p>
    </div>
    <style>
      #sim-root {
        display: none;
      }
    </style>
  </noscript>

  <div id="sim-root">
    <Simulator client:load />
  </div>

  <div class="wrap mt-12">
    <p class="text-sm">
      <a href={withBase('/simulateur/cas-types/')}>Qui gagne, qui perd ? Voir des foyers types →</a>
    </p>
  </div>
</BaseLayout>

<style is:global>
  .sim-loading,
  .sim-timeout {
    display: none;
  }
  html[data-sim-hash='1'] .sim-loading,
  html[data-sim-hash='timeout'] .sim-timeout {
    display: block;
  }
  html[data-sim-hash='1'] #sim-root {
    display: none;
  }
  /* On a phone, once the result is open it starts right under the site header. */
  @media (max-width: 639.98px) {
    html[data-sim-view='result'] .sim-page-header {
      display: none;
    }
  }
</style>
