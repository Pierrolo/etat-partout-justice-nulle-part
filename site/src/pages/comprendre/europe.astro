---
import EuropeBlock from '@/components/story/EuropeBlock.astro';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { num } from '@/lib/facts';
import { formatNumber } from '@/lib/format';

const fr = num('eu_dep_pib_fr_2024_pct');
const ea = num('eu_dep_pib_ea20_2024_pct');
---

<DashboardLayout
  slug="europe"
  lede={`Dépenses publiques en points de PIB (${formatNumber(fr, { decimals: 1 })} % pour la France, ${formatNumber(ea, { decimals: 1 })} % pour la zone euro), déficit, revenu médian : la France comparée à ses voisins, avec l’écart converti en euros par foyer.`}
>
  <EuropeBlock />
</DashboardLayout>
