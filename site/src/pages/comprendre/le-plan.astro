---
import { HourBar } from '@/components/story/HourBar';
import { Lifecycle } from '@/components/story/Lifecycle';
import { PlanSankey } from '@/components/story/PlanSankey';
import { Callout, Disclosure, SourceChip, TierBadge } from '@/components/ui';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { chip, conflicts, datasetChip, fact, num } from '@/lib/facts';
import { formatEuro, formatMdEuro, formatNumber, formatPercentPoints } from '@/lib/format';
import { lifecycleData, planSankey } from '@/lib/plan-data';
import { withBase } from '@/lib/site';

// ── Sankey ──────────────────────────────────────────────────────────────────
const sk = planSankey();
const total = num('eco236_total_md');
const sankeySources = [
  datasetChip(sk.source, { label: 'Chiffrage publié, Annexe Manuscrit', tier: 'annonce' }),
  chip('csg_cout_annee_pleine_md_loi', { label: 'Amendement PLFSS n° 1 (CSG/CRDS)' }),
];
const rec = sk.reconciliation;
const nf3 = (v: number) => formatNumber(v, { decimals: 3 });

// ── Heure de travail, CSG ───────────────────────────────────────────────────
const csgMois = num('csg_gain_median_mois_eur');
const csgPct = num('csg_gain_median_pct');
const csgManifesteMois = num('csg_gain_median_manifeste_eur_mois');
const netMedian = num('csg_salaire_net_median_eur');
const csgNote = conflicts('csg_gain_median_mois_eur')[0]?.note ?? '';

// ── Cycle de vie ────────────────────────────────────────────────────────────
const life = lifecycleData();
const lifeSources = [
  datasetChip(life.source, { label: 'Chiffrage publié, GraphAFU', tier: 'annonce' }),
  chip('afu_adulte_eur_an', { label: 'Amendement PLF-P1 n° 28 (aide fondamentale)' }),
];

// ── Écrit / annoncé ─────────────────────────────────────────────────────────
const afuYear = fact('afu_adulte_eur_an').year;
const tvaSteps = [
  { pct: num('tva_alimentation_palier_1_pct'), year: fact('tva_alimentation_palier_1_pct').year },
  { pct: num('tva_alimentation_palier_2_pct'), year: fact('tva_alimentation_palier_2_pct').year },
  { pct: num('tva_alimentation_palier_3_pct'), year: fact('tva_alimentation_palier_3_pct').year },
];
const written = [
  {
    text: `Fin de la CSG et de la CRDS sur les revenus d’activité : ${formatMdEuro(num('csg_cout_annee_pleine_md_loi'))} par an en année pleine, ${formatMdEuro(num('csg_cout_2027_md_loi'))} dès 2027.`,
    chip: chip('csg_cout_annee_pleine_md_loi', { label: 'Amendement PLFSS n° 1' }),
  },
  {
    text: `Aide fondamentale universelle dès ${afuYear} : ${formatEuro(num('afu_adulte_eur_an'))} par an et par adulte (${formatEuro(num('afu_adulte_eur_mois'))} par mois), ${formatEuro(num('afu_enfant_eur_an'))} par enfant à charge.`,
    chip: chip('afu_adulte_eur_an', { label: 'Amendement PLF-P1 n° 28' }),
  },
  {
    text: `Impôt sur le revenu à taux unique de ${formatPercentPoints(num('ir_taux_unique_pct'), { decimals: 0 })} ; impôt sur les sociétés à ${formatPercentPoints(num('is_taux_unique_pct'), { decimals: 0 })}.`,
    chip: chip('ir_taux_unique_pct', { label: 'Amendements PLF-P1' }),
  },
  {
    text: `TVA sur l’alimentation : ${tvaSteps.map((s) => `${formatPercentPoints(s.pct, { decimals: 0 })} en ${s.year}`).join(', puis ')}.`,
    chip: chip('tva_alimentation_palier_1_pct', { label: 'Amendements PLF-P1', year: false }),
  },
  {
    text: `${formatMdEuro(num('credits_retires_cp_md'))} de crédits de paiement retirés à ${formatNumber(num('credits_retires_amendements_nombre'))} missions (état B, ${fact('credits_retires_cp_md').year}).`,
    chip: chip('credits_retires_cp_md', { label: 'Amendements PLF-P2, état B' }),
  },
  {
    text: `${formatNumber(num('emplois_etat_fermes_annee_pleine_loi'))} emplois d’État fermés en année pleine.`,
    chip: chip('emplois_etat_fermes_annee_pleine_loi', { label: 'Amendement PLF-P2 n° 24' }),
  },
];
const announced = [
  {
    text: `${formatMdEuro(total)} d’économies par an, estimations du chiffrage.`,
    chip: chip('eco236_total_md', { label: 'Chiffrage publié' }),
  },
  {
    text: `Compte d’épargne retraite : « ${formatEuro(num('restitution_epargne_manifeste_eur_mois'))} par mois d’ici trois ans ». Montant inscrit dans l’amendement : ${formatEuro(num('cep_montant_loi_eur'))} ; il serait fixé chaque année par la loi de finances.`,
    chip: chip('restitution_epargne_manifeste_eur_mois', { label: 'Annonce' }),
  },
  {
    text: `Restitution de ${formatMdEuro(num('actifs_manifeste_md'))} de patrimoine public aux Français, soit ${formatEuro(num('actifs_par_foyer_manifeste_eur'))} par foyer en trois ans.`,
    chip: chip('actifs_manifeste_md', { label: 'Annonce' }),
  },
  {
    text: `Indemnisation du chômage ramenée de ${formatNumber(num('chomage_duree_avant_mois'))} à ${formatNumber(num('chomage_duree_apres_mois'))} mois : annoncé, sans texte de loi.`,
    chip: chip('chomage_duree_apres_mois', { label: 'Fiche' }),
  },
  {
    text: `« ${formatEuro(num('restitution_totale_manifeste_eur_mois'))} par mois rendus aux travailleurs » (${formatEuro(csgManifesteMois)} de salaire net et ${formatEuro(num('restitution_epargne_manifeste_eur_mois'))} d’épargne) : non vérifiable à partir des chiffrages publiés.`,
    chip: chip('restitution_totale_manifeste_eur_mois', { label: 'Annonce' }),
  },
];
---

<DashboardLayout
  slug="le-plan"
  lede={`D’où viennent ${formatMdEuro(total)} d’économies par an, où elles vont (salaire net, épargne), et ce que l’amendement écrit noir sur blanc.`}
>
  <section aria-labelledby="schema-titre" class="space-y-4">
    <div class="max-w-2xl space-y-2">
      <h2 id="schema-titre" class="sr-only">
        Le schéma
      </h2>
      <p class="text-ink-2">
        Le plan propose de réduire la dépense publique et de « rendre » l’argent aux Français, de
        deux façons : en supprimant la CSG et la CRDS sur les salaires (le salaire net augmente), et
        en alimentant une épargne personnelle. Voici ce schéma, avec la part proposée dans un
        amendement et celle qui reste une estimation.
      </p>
    </div>
    <PlanSankey
      client:visible={{ rootMargin: '400px' }}
      nodes={sk.nodes}
      links={sk.links}
      sources={sankeySources}
      total={sk.total}
      year1={sk.year1}
    />
    <Callout
      tone="note"
      title={`Trois façons de compter « ${formatNumber(total, { decimals: 0 })} milliards »`}
    >
      <p>
        Selon la ligne et la feuille du classeur, le total vaut{' '}
        {nf3(rec.totaux.annexe_manuscrit_colonne_C)}&nbsp;Md€ (colonne C),{' '}
        {nf3(rec.totaux.annexe_manuscrit_E_plus_F)}&nbsp;Md€ (années 1 et pleine additionnées, ce
        schéma) ou
        {nf3(rec.totaux.destinations_classeur_114_46_plus_121_749)}&nbsp;Md€ (somme des deux
        destinations). Les trois s’arrondissent à {formatNumber(total, { decimals: 0 })}. De même,
        le gain de la première année est de {nf3(sk.year1)}&nbsp;Md€ dans l’annexe et de{' '}
        {formatNumber(sk.year1Flux, { decimals: 1 })}&nbsp;Md€ dans la feuille « Flux ».
      </p>
      <p class="mt-2 text-sm text-ink-3">
        Ce schéma utilise uniquement l’annexe. Le classeur contient un second schéma, légèrement
        différent ; nous ne les mélangeons jamais.
      </p>
      <p class="mt-3 flex flex-wrap items-center gap-2">
        <SourceChip {...chip('eco236_total_md', { label: 'Total : colonne C' })} />
        <SourceChip {...chip('plan_gain_annee_1_flux_md', { label: 'Année 1 : feuille Flux' })} />
      </p>
    </Callout>
  </section>

  <!-- Votre heure de travail -->
  <section aria-labelledby="heure-titre" class="space-y-4">
    <div class="max-w-2xl space-y-2">
      <h2 id="heure-titre" class="text-3xl text-ink">
        Votre heure de travail
      </h2>
      <p class="text-ink-2">
        Une heure de travail crée de la valeur : combien va à l’État, au capital, au salarié ? Voici
        le découpage annoncé, aujourd’hui.
      </p>
    </div>
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="card space-y-4">
        <p class="flex flex-wrap items-center justify-between gap-3">
          <span class="eyebrow eyebrow-accent">Aujourd’hui</span>
          <TierBadge tier="announced" size="sm" short />
        </p>
        <HourBar />
      </div>
      <div class="card space-y-4">
        <p class="flex flex-wrap items-center justify-between gap-3">
          <span class="eyebrow eyebrow-accent">Avec le plan</span>
          <TierBadge tier="announced" size="sm" short />
        </p>
        <p class="font-serif text-xl font-medium leading-snug tracking-tight text-ink sm:text-2xl">
          Pas de découpage publié : un seul changement est chiffré.
        </p>
        <p class="text-[0.9375rem] leading-relaxed text-ink-2">
          Le chiffrage publié ne donne pas de version « avec le plan » de ces{' '}
          {formatEuro(num('va_heure_total_eur'))}. Il ne chiffre qu’un changement : la fin de la CSG
          et de la CRDS ajouterait <strong class="text-gain">{formatEuro(csgMois)} par mois</strong>{' '}
          au salaire net médian de {formatEuro(netMedian)}, soit{' '}
          <strong class="text-gain">
            {formatNumber(csgPct, { decimals: 1, signed: true })}&nbsp;%
          </strong>
          .
        </p>
        <p class="rounded-md bg-sunken p-3 text-sm leading-relaxed text-ink-2">
          <strong class="text-ink">Les sources divergent.</strong>
          {csgNote}
        </p>
        <p class="flex flex-wrap items-center gap-2 text-xs text-ink-3">
          <span class="font-semibold">Sources&nbsp;:</span>
          <SourceChip
            {...chip('csg_gain_median_mois_eur', { label: 'Chiffrage publié, CSG-CRDS' })}
          />
          <SourceChip {...chip('csg_gain_median_manifeste_eur_mois', { label: 'Annonce' })} />
        </p>
        <a href={withBase('/simulateur/')} class="btn btn-primary w-full justify-between sm:w-auto">
          <span>Calculer pour votre paie</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Cycle de vie -->
  <section aria-labelledby="vie-titre" class="space-y-4">
    <div class="max-w-2xl space-y-2">
      <h2 id="vie-titre" class="text-3xl text-ink">
        Au fil de la vie
      </h2>
      <p class="text-ink-2">
        Le graphique « Solidarité nationale au cours de la vie » montre ce qu’une personne recevrait
        de la naissance à {formatNumber(life.ageMax)} ans. Nous y séparons ce qui a une base légale
        de ce qui n’en a pas.
      </p>
    </div>
    <Lifecycle
      client:visible={{ rootMargin: '400px' }}
      series={life.series}
      rows={life.rows}
      sources={lifeSources}
    />
  </section>

  <!-- Écrit / annoncé -->
  <section aria-labelledby="ea-titre" class="space-y-4">
    <div class="max-w-2xl space-y-2">
      <h2 id="ea-titre" class="text-3xl text-ink">
        Ce qui est écrit, ce qui est annoncé
      </h2>
      <p class="text-ink-2">
        La même ligne sépare tout le site : un chiffre inscrit dans un amendement n’a pas le statut
        d’une promesse. Voici les deux listes pour ce plan.
      </p>
    </div>
    <div class="grid gap-4 lg:grid-cols-2 lg:gap-6">
      <div class="card space-y-4">
        <TierBadge tier="law" />
        <ul class="space-y-4">
          {written.map((w) => (
            <li class="space-y-1.5 border-t border-rule pt-3 first:border-t-0 first:pt-0">
              <p class="text-[0.9375rem] leading-relaxed text-ink">{w.text}</p>
              <SourceChip {...w.chip} />
            </li>
          ))}
        </ul>
      </div>
      <div class="hatch card space-y-4 border-[1.5px] border-dashed border-[var(--tier-announced-bd)]">
        <TierBadge tier="announced" />
        <ul class="space-y-4">
          {announced.map((a) => (
            <li class="space-y-1.5 border-t border-dashed border-rule-strong pt-3 first:border-t-0 first:pt-0">
              <p class="text-[0.9375rem] leading-relaxed text-ink">{a.text}</p>
              <SourceChip {...a.chip} />
            </li>
          ))}
        </ul>
      </div>
    </div>
    <Disclosure summary="Comment lire ces deux colonnes ?" variant="card">
      <p>
        « Proposé dans un amendement » : le chiffre figure dans un amendement rédigé et publié, pas
        en vigueur. Il s’appliquerait tel quel s’il était adopté. « Annoncé » : avancé dans le
        manifeste, les fiches ou le chiffrage publié, sans texte précis. Le simulateur montre les
        promesses sans montant à part, hors de votre revenu disponible.{' '}
        <a href={withBase('/methode/')}>Méthode et hypothèses</a>.
      </p>
    </Disclosure>
  </section>
</DashboardLayout>
