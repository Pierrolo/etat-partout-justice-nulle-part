{
  "name": "etat-partout-justice-nulle-part",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "« Et moi, dans tout ça ? » — compagnon indépendant et open source du livre « État partout, justice nulle part ».",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @epjn/site dev",
    "build": "pnpm --filter @epjn/site build",
    "preview": "pnpm --filter @epjn/site preview",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @epjn/site test:e2e",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
